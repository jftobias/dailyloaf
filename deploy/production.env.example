# Safe placeholders only. Set real values as Railway service variables / Vercel env vars.
# Railway API service (service root: /api, builder: Dockerfile):
RAILS_ENV=production
RAILS_MASTER_KEY=<contents of api/config/credentials/production.key>
# Railway reference variables pointing at the PostgreSQL service named "Postgres".
# Do not copy raw credentials manually; do not enable public networking on Postgres.
DATABASE_URL=${{Postgres.DATABASE_URL}}
# Beta single-service topology: same Railway PostgreSQL URL, separate Rails cache
# connection with its own migration path (db/cache_migrate).
CACHE_DATABASE_URL=${{Postgres.DATABASE_URL}}
CORS_ORIGINS=https://dailyloaf.online
FRONTEND_URL=https://dailyloaf.online
# Shared custom parent domain → lax. Temporary *.vercel.app/*.up.railway.app
# cross-site testing uses none (Secure + HTTPS required) instead.
SESSION_COOKIE_SAME_SITE=lax
RAILS_MAX_THREADS=5
WEB_CONCURRENCY=1
RAILS_LOG_TO_STDOUT=true
# PORT is supplied by Railway; do not define it.
# Seal RAILS_MASTER_KEY in the Railway dashboard after adding it.

# Vercel project environment (set only after the API custom domain is live):
# NEXT_PUBLIC_API_URL=https://api.dailyloaf.online
