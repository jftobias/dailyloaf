# Safe placeholders only. Set real values in Railway/Vercel secret managers.
RAILS_ENV=production
RAILS_MASTER_KEY=<railway-secret-production-key>
DATABASE_URL=<railway-private-postgresql-url>
# Beta single-service topology: same Railway PostgreSQL URL, separate Rails cache table namespace.
CACHE_DATABASE_URL=<same-railway-private-postgresql-url>
CORS_ORIGINS=https://app.<custom-domain>
FRONTEND_URL=https://app.<custom-domain>
RAILS_MAX_THREADS=5
WEB_CONCURRENCY=1
RAILS_LOG_TO_STDOUT=1
# Temporary provider-domain browser testing uses HTTPS-only cross-site cookies.
SESSION_COOKIE_SAME_SITE=none
# PORT is supplied by Railway; do not hard-code it here.

# Vercel project environment:
# NEXT_PUBLIC_API_URL=https://api.<custom-domain>
